# Uncomment this line to define a global platform for your project
# Firebase iOS 12.x requires iOS 15.0+
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Sync Google Maps API key from repo-root dart_defines.json into Flutter xcconfig (same source as Gradle).
def sync_maps_key_from_dart_defines
  require 'json'
  defines_path = File.expand_path('../dart_defines.json', __dir__)
  xcconfig_path = File.expand_path('Flutter/MapsKey.generated.xcconfig', __dir__)
  key = ''
  if File.exist?(defines_path)
    begin
      data = JSON.parse(File.read(defines_path))
      key = data['GOOGLE_MAPS_API_KEY'].to_s.strip
      key = data['MAPS_SDK_API_KEY'].to_s.strip if key.empty?
    rescue JSON::ParserError
      key = ''
    end
  end
  File.write(xcconfig_path, "GOOGLE_MAPS_API_KEY=#{key}\n")
end

# iOS OAuth client ID + reversed URL scheme for Google Sign-In 8.x (GIDClientID / CFBundleURLSchemes).
def reverse_google_ios_client_id(client_id)
  s = client_id.to_s.strip
  return '' if s.empty?
  return '' unless s.end_with?('.apps.googleusercontent.com')

  prefix = s.sub(/\.apps\.googleusercontent\.com\z/, '')
  "com.googleusercontent.apps.#{prefix}"
end

def sync_google_sign_in_ios_from_dart_defines
  require 'json'
  defines_path = File.expand_path('../dart_defines.json', __dir__)
  xcconfig_path = File.expand_path('Flutter/GoogleSignInIos.generated.xcconfig', __dir__)
  client_id = ''
  web_client_id = ''
  if File.exist?(defines_path)
    begin
      data = JSON.parse(File.read(defines_path))
      client_id = data['GOOGLE_IOS_CLIENT_ID'].to_s.strip
      web_client_id = data['GOOGLE_WEB_CLIENT_ID'].to_s.strip
    rescue JSON::ParserError
      client_id = ''
      web_client_id = ''
    end
  end
  reversed = reverse_google_ios_client_id(client_id)
  File.write(
    xcconfig_path,
    <<~EOS
      GOOGLE_IOS_CLIENT_ID=#{client_id}
      GOOGLE_IOS_REVERSED_CLIENT_ID=#{reversed}
      GOOGLE_WEB_CLIENT_ID=#{web_client_id}
    EOS
  )
end

flutter_ios_podfile_setup
sync_maps_key_from_dart_defines
sync_google_sign_in_ios_from_dart_defines

target 'Runner' do
  # Firebase pods often break with "Include of non-modular header inside framework module"
  # when built as dynamic frameworks. Prefer static linkage + modular headers.
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # App Store Connect symbol upload expects dSYMs for Release archives.
      # Using only "dwarf" for pods can trigger missing ObjectiveC.framework dSYM warnings.
      if config.name == 'Release' || config.name == 'Profile'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      elsif config.build_settings['DEBUG_INFORMATION_FORMAT'] == nil
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
      end
      # Remove unsupported compiler flags
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_SWIFT_FLAGS'].each do |flag_key|
        flags = config.build_settings[flag_key] || ['$(inherited)']
        flags = flags.is_a?(String) ? flags.split(' ') : flags
        flags.reject! { |flag| flag == '-G' || flag.start_with?('-G') }
        config.build_settings[flag_key] = flags
      end

      # permission_handler_apple: each permission defaults to 0 (disabled) unless a macro is set.
      # Without these, iOS can show the system sheet but the plugin still reports "denied".
      if target.name == 'permission_handler_apple'
        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
        if defs.nil?
          defs = ['$(inherited)']
        elsif defs.is_a?(String)
          defs = defs.split(' ').reject(&:empty?)
        else
          defs = defs.reject { |x| x.to_s.empty? }.dup
        end
        %w[
          PERMISSION_LOCATION=1
          PERMISSION_CAMERA=1
          PERMISSION_PHOTOS=1
          PERMISSION_CONTACTS=1
        ].each do |macro|
          key = macro.split('=', 2).first
          defs.reject! { |d| d.to_s.start_with?("#{key}=") }
          defs << macro unless defs.include?(macro)
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      end

      # Xcode 16.4 + current gRPC sources trigger a warning that is treated as error in some setups.
      # Keep the pod buildable by downgrading that one diagnostic.
      if ['gRPC-Core', 'gRPC-C++'].include?(target.name)
        cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        cxxflags = cxxflags.is_a?(String) ? cxxflags.split(' ') : cxxflags
        cxxflags << '-Wno-error=missing-template-arg-list-after-template-kw'
        cxxflags << '-Wno-missing-template-arg-list-after-template-kw'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxxflags.uniq
      end
    end

    # CocoaPods injects an invalid flag into BoringSSL-GRPC sources:
    # "-GCC_WARN_INHIBIT_ALL_WARNINGS" which Clang interprets as "-G ..."
    # and fails for iOS targets.
    if target.name == 'BoringSSL-GRPC' && target.respond_to?(:source_build_phase)
      target.source_build_phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']

        flags_str = file.settings['COMPILER_FLAGS']
        next unless flags_str.is_a?(String)

        flags = flags_str.split(' ')
        flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
        file.settings['COMPILER_FLAGS'] = flags.join(' ')
      end
    end
  end
end
