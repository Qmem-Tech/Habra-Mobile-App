<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- flutter_stripe + Stripe SDK: Activity theme must be Theme.MaterialComponents (or AppCompat)
         with colorPrimary resolvable — see ThemeEnforcement.isAppCompatTheme. -->
    <style name="LaunchTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="colorPrimary">@color/habra_brand_primary</item>
        <item name="colorPrimaryVariant">@color/habra_brand_primary_dark</item>
    </style>
    <style name="NormalTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="colorPrimary">@color/habra_brand_primary</item>
        <item name="colorPrimaryVariant">@color/habra_brand_primary_dark</item>
    </style>
</resources>
